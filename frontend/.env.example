# Copy to frontend/.env.local (git-ignored) and fill in.

# The Django backend's origin — no trailing slash, no /api. Leave it empty to
# keep accounts in the browser only (src/signup/backends/local.js): fine for
# trying the sign-up page, not for launch.
#
# Whatever origin this page is served from must be in the backend's
# CORS_ALLOWED_ORIGINS (the root .env), or the browser will block every call.
#
#   Local, with `python manage.py runserver` (CORS: http://localhost:5173):
#VITE_API_URL=http://localhost:8000
#
#   Production (CORS: the site's own domain):
#VITE_API_URL=https://your-backend.onrender.com
