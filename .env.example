# Backend settings. Copy to `.env` here at the repo root (git-ignored) —
# backend/config/settings.py loads it from this folder, not from /backend.

# Any long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=

# Local development: debug on, plain HTTP. In production DEBUG=False and
# HTTPS_LEVEL=1 (redirect to HTTPS, secure cookies) or 2 (adds HSTS).
DEBUG=True
HTTPS_LEVEL=0

# Hostnames this server answers to, comma-separated.
ALLOWED_HOSTS=localhost,127.0.0.1

# The site(s) allowed to call the API from a browser, comma-separated, with
# scheme and port. `npm run dev` serves on http://localhost:5173.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Leave unset for a local SQLite file (backend/db.sqlite3); set to the
# Postgres/Supabase URL in production.
#DATABASE_URL=postgres://user:password@host:5432/dbname

# Rate limit per client: at most this many requests per window of seconds.
THROTTLE_MAX_QUEUE_LENGTH=2
THROTTLE_WINDOW_LENGTH=1

# The adress the frontend will send api calls to
VITE_API_URL=http://localhost:8000